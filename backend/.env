# Backend environment variables
# MongoDB connection URI for Atlas or local MongoDB.
MONGO_URI="mongodb+srv:db_user:password.ihi5phu.mongodb.net/?appName=India"
# Optional MongoDB database name. If omitted, the driver default is used.
MONGO_DB_NAME="storage"
# Optional MongoDB collection name for vector/text documents.
MONGO_COLLECTION_NAME="documents"
# Optional Atlas index names for vector search and text search.
MONGO_VECTOR_INDEX_NAME="vector"
MONGO_TEXT_INDEX_NAME="bm25"

GROQ_API_KEY="API KEY"
GROQ_MODEL_NAME="llama-3.1-8b-instant"
BGE_MODEL_NAME="bge-base-en"
